  "components": [
    {
      "name": "开始防守",
      "kind": "button",
      "description": "竖屏战前主按钮，420 × 84 设计单位。",
      "html": "<button class=\"primary\">开始防守</button>",
      "css": ".primary{width:420px;height:84px;border:0;border-radius:12px;background:#337354;color:#FCFDF7;font:700 26px sans-serif}",
      "refersTo": "button-primary"
    },
    {
      "name": "暂停控制",
      "kind": "button",
      "description": "底部战斗控制，200 × 84。",
      "html": "<button class=\"secondary\">暂停</button>",
      "css": ".secondary{width:200px;height:84px;border:0;border-radius:12px;background:#D9E6D0;color:#234235;font:700 26px sans-serif}",
      "refersTo": "button-secondary"
    },
    {
      "name": "四宠头像栏",
      "kind": "card",
      "description": "四个 120×106 纯头像；灵露不足时增加 #234235、alpha 150/255 的半透明蒙层，恢复可支付时移除；保持可查看与拖动。",
      "html": "<div class=\"avatars\"><i title=\"爪爪猫\"></i><i title=\"星弹兔\"></i><i title=\"铃芽鹿\"></i><i title=\"茸茸菇\"></i></div>",
      "css": ".avatars{display:flex;gap:40px;padding:12px;background:#EDF3E7}.avatars i{box-sizing:border-box;width:120px;height:106px;border-radius:22px;background:radial-gradient(circle,#F1AF64 34%,#FCFDF7 35%);border:3px solid #B85C20}.avatars i:nth-child(2){background:radial-gradient(circle,#96CBE3 34%,#FCFDF7 35%);border-color:transparent}.avatars i:nth-child(3){background:radial-gradient(circle,#C9AD77 34%,#FCFDF7 35%);border-color:transparent}.avatars i:nth-child(4){background:radial-gradient(circle,#CE9DD1 34%,#FCFDF7 35%);border-color:transparent}",
      "refersTo": "pet-card"
    },
    {
      "name": "后备伙伴",
      "kind": "button",
      "description": "弹窗内 3 列 4 行，单格 188 × 86。",
      "html": "<button class=\"reserve\">爪爪猫 #1<br>免费部署</button>",
      "css": ".reserve{width:188px;height:86px;border:0;border-radius:12px;background:#D9E6D0;color:#234235;font:26px/1.45 sans-serif}"
    },
    {
      "name": "战斗结算",
      "kind": "card",
      "description": "640 × 440，遮罩拦截战场输入。",
      "html": "<div class=\"result\"><strong>这一站，守住了。</strong><p>带着萌宠小队，继续出发。</p><button>继续选择路线</button></div>",
      "css": ".result{box-sizing:border-box;width:640px;height:440px;border-radius:20px;background:#FCFDF7;color:#234235;display:flex;flex-direction:column;align-items:center;justify-content:space-evenly;font:26px sans-serif}.result strong{font-size:36px}.result button{width:560px;height:84px;border:0;border-radius:12px;background:#337354;color:#FCFDF7;font:700 26px sans-serif}"
    },
    {
      "name": "竖屏提示",
      "kind": "card",
      "description": "横屏只呈现提示，冻结战斗，回竖屏恢复方向造成的暂停。",
      "html": "<div class=\"gate\"><strong>请竖屏游玩</strong><p>本游戏仅支持竖屏。</p></div>",
      "css": ".gate{width:420px;padding:32px;text-align:center;background:#EDF3E7;color:#234235;font:16px/1.7 sans-serif}.gate strong{font-size:30px}"
    },
    {
      "name": "宠物数据卡",
      "kind": "card",
      "description": "656 × 152，名称、攻击/施法数据、效果、部署信息；选中实例支持收回。",
      "html": "<div class=\"info\"><strong>铃芽鹿 · 增益</strong><span>施法范围 185 · 友军攻击力 +40% · 不攻击</span><span>范围内友军获得增益，同类光环不叠加</span></div>",
      "css": ".info{width:656px;height:152px;box-sizing:border-box;padding:16px 20px;display:flex;flex-direction:column;justify-content:space-around;border-radius:16px;background:#FCFDF7;color:#234235;font:23px sans-serif}.info strong{font-size:28px;color:#4D8251}"
    },
    {
      "name": "通用 Toast",
      "kind": "card",
      "description": "616×88，warning/info/success；2.4 秒自动消失，不阻挡手势，不因相同消息反复续时。",
      "html": "<div class=\"toast\"><b>!</b><span>灵露不足，还差 30 灵露</span></div>",
      "css": ".toast{box-sizing:border-box;width:616px;min-height:88px;padding:16px 24px;border:2px solid #F1AF64;border-radius:18px;background:rgba(35,66,53,.96);color:#FCFDF7;display:flex;gap:24px;align-items:center;font:700 26px/1.3 sans-serif}.toast b{color:#F1AF64;font-size:30px}.toast span{flex:1;text-align:center}"
    }
  ],
  "narrative": {
    "northStar": "浅色森林棋盘",
    "overview": "仅竖屏的程序绘制塔防：左上雾兽入口、右下摇篮树、16 个树桩；顶部状态和选中数据，底部四个纯头像。猫近战、兔远程、鹿增益、菇持续伤害。点击查看范围与数据，场上长按 0.3 秒拖到空位搬迁。",
    "keyCharacteristics": [
      "浅绿战场、沙色折返道路，角色色辅助区分四种定位。",
      "范围和即时数据集中显示，头像栏不放文字。",
      "范围/特效在战场内裁切，拖动头像独立显示。"
    ],
    "rules": [
      {
        "name": "The Color-and-Words Rule",
        "body": "选中同时显示角色色描边和“已选中”；路线同时用形状、连线和“沿连线解锁 / 已守住”文案说明状态。",
        "section": "colors"
      }
    ],
    "dos": [
      "保持浅色森林、橙猫和蓝兔。",
      "以 720 × 1280 设计坐标核对文字和触点。",
      "方向变化时冻结战斗并保留玩家手动暂停状态。"
    ],
    "donts": [
      "不要添加横屏玩法布局。",
      "不要通过适配布局改变战斗数值。",
      "不要把此面板的 HTML/CSS 当作游戏运行时实现。"
    ]
  }
}
