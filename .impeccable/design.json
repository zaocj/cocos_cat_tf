  "narrative": {
    "northStar": "浅色森林棋盘",
    "overview": "浅绿棋盘承载路线、道路、树桩与伙伴。深绿文字保持清楚的层级，橙猫与蓝兔用颜色和轮廓共同区分近战、远程；这是用户确认的视觉方向。\n\n本规范记录 Cocos Creator 3.8.8 的 `Graphics` / `Label` 实现。所有角色与界面均程序绘制，优先支持选择、放置和防守；以下尺寸均为 1280 × 720 设计坐标中的单位，前置 token 的 `px` 是交换格式表达，并非 CSS 实现。依据为 `assets/scripts/presentation/MvpGame.ts` 与 `.impeccable/review/` 的四张实际 Web 构建截图。",
    "keyCharacteristics": [
      "浅绿底、沙色道路、深绿信息与主要操作。",
      "圆角容器、圆形树桩及几何角色，不依赖外部美术素材。",
      "颜色、描边和中文状态文案共同说明可用与选中状态。"
    ],
    "rules": [
      {
        "name": "The Color-and-Words Rule",
        "body": "选中同时显示角色色描边和“已选中”；路线同时用形状、连线和“沿连线解锁 / 已守住”文案说明状态。",
        "section": "colors"
      }
    ],
    "dos": [
      "Do 保持浅色森林棋盘、橙猫、蓝兔与程序绘制方向。",
      "Do 让选择、部署、锁定和完成状态同时有可见图形差异与中文文案。",
      "Do 以 1280 × 720 设计坐标核对整体缩放后的文字、树桩与操作栏。"
    ],
    "donts": [
      "Don't 把颜色当作近远程或交互状态的唯一线索。",
      "Don't 将文档 token 当作游戏中已存在的 CSS 变量或外部字体依赖。",
      "Don't 将当前等比缩放描述为已完成手机竖屏重排或键盘焦点系统。"
    ]
  }
}
